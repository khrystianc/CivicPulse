# Flask Configuration
FLASK_DEBUG=False
HOST=0.0.0.0
PORT=5000

# CORS Configuration
# In production, set this to your specific domain(s)
# Example: CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=civicpulse
# For production, always set username and password
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Application Configuration
APP_NAME=CivicPulse
APP_VERSION=1.0.0

# Security Configuration (Production)
# Rate limiting is enabled by default with sensible defaults
# HTTPS should be enforced at the server/proxy level (nginx, etc.)
